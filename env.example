# --- База данных (docker compose up -d) ---
POSTGRES_URL=postgresql://dev_user:dev_password@localhost:5432/postgres_dev

# --- Better Auth ---
# Сгенерировать: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Публичные (в Docker передаются как build args) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_YM_ID=106365667

# --- Загруженные файлы (в проде — Docker volume /data/uploads) ---
UPLOAD_DIR=./.data/uploads

# --- Email (Яндекс 360, необязательно: без этого письма пропускаются) ---
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
LEADS_EMAIL_TO=

# --- Telegram (необязательно) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Cron (Dokploy Schedules шлют Authorization: Bearer $CRON_SECRET) ---
CRON_SECRET=

# --- E2E (Playwright): реальные значения — только в .env.e2e (git-ignored) ---
# Учётка администратора, которую создаёт `pnpm e2e:db` и под которой входит e2e/auth.setup.ts
# E2E_ADMIN_EMAIL=admin-e2e@example.com
# E2E_ADMIN_PASSWORD=change-me-e2e-password
